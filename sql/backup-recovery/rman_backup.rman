# RMAN backup scripts. Run as: rman target / @rman_backup.rman  (after selecting one block)
# Not executed in this repository. Adjust channels, destinations and retention to your standards.

# --8<-- [start:config]
CONFIGURE RETENTION POLICY TO RECOVERY WINDOW OF 14 DAYS;
CONFIGURE CONTROLFILE AUTOBACKUP ON;
CONFIGURE BACKUP OPTIMIZATION ON;
CONFIGURE DEVICE TYPE DISK PARALLELISM 4 BACKUP TYPE TO COMPRESSED BACKUPSET;
CONFIGURE ARCHIVELOG DELETION POLICY TO BACKED UP 1 TIMES TO DISK;
SHOW ALL;
# --8<-- [end:config]

# --8<-- [start:level0]
RUN {
  BACKUP INCREMENTAL LEVEL 0 DATABASE TAG 'WEEKLY_L0' PLUS ARCHIVELOG TAG 'WEEKLY_ARCH';
  BACKUP CURRENT CONTROLFILE TAG 'WEEKLY_CF';
  DELETE NOPROMPT OBSOLETE;
}
# --8<-- [end:level0]

# --8<-- [start:level1]
RUN {
  BACKUP INCREMENTAL LEVEL 1 DATABASE TAG 'DAILY_L1' PLUS ARCHIVELOG TAG 'DAILY_ARCH';
  DELETE NOPROMPT OBSOLETE;
}
# --8<-- [end:level1]

# --8<-- [start:arch]
BACKUP ARCHIVELOG ALL NOT BACKED UP 1 TIMES TAG 'ARCH';
DELETE NOPROMPT ARCHIVELOG ALL BACKED UP 1 TIMES TO DISK COMPLETED BEFORE 'SYSDATE - 1';
# --8<-- [end:arch]

# --8<-- [start:validate]
BACKUP VALIDATE CHECK LOGICAL DATABASE ARCHIVELOG ALL;
RESTORE DATABASE VALIDATE;
RESTORE ARCHIVELOG FROM TIME 'SYSDATE - 1' VALIDATE;
RESTORE CONTROLFILE VALIDATE;
RESTORE SPFILE VALIDATE;
LIST BACKUP SUMMARY;
REPORT NEED BACKUP;
REPORT UNRECOVERABLE;
# --8<-- [end:validate]
