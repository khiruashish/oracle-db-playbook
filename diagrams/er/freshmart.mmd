        number order_id PK
        number customer_id FK
        number address_id FK
        number warehouse_id FK
        number coupon_id FK
        date order_date
        varchar2 status
        number subtotal
        number discount_amount
        number delivery_fee
        number total_amount
    }
    ORDER_ITEMS {
        number order_id PK,FK
        number line_no PK
        number product_id FK
        number quantity
        number unit_price
        number line_total "virtual"
    }
    PAYMENTS {
        number payment_id PK
        number order_id FK
        varchar2 payment_method
